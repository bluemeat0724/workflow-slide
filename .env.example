# =============================================================================
# Workflow Tool - Unified Environment Configuration
# =============================================================================
#
# This root `.env` is the single source of truth for:
# - local `npm run ...` commands inside `app/`
# - root `docker compose ...`
#
# Local app commands now load `../.env` automatically.

# =============================================================================
# Frontend Configuration
# =============================================================================

# local-only (no database, browser local draft only — via npm run frontend)
VITE_STORAGE_MODE=local-only

# Show JSON import/export buttons in the toolbar. Set to "true" to enable.
# Default: hidden.
# VITE_SHOW_IMPORT_EXPORT=true

# remote (connect to remote API server — via npm run frontend)
# VITE_STORAGE_MODE=remote
# VITE_API_BASE_URL=https://example.com/api

# Full-stack local development (via npm run dev)
# VITE_STORAGE_MODE=local-db
# VITE_API_BASE_URL=/api

# =============================================================================
# Server Configuration
# =============================================================================

# Required. Database type is selected only through this variable.
# Allowed values: "postgres" or "sqlite"
STORAGE_DRIVER=postgres

# Server port
# PORT=3103

# Schema version
# SCHEMA_VERSION=1.0

# Default dev user
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
# DEFAULT_USER_EMAIL=local-dev@workflow-tool.local
# DEFAULT_USER_NAME=Local Dev User

# =============================================================================
# AI Configuration
# =============================================================================
#
# 项目使用 OpenAI SDK，默认指向 DeepSeek API（OpenAI 兼容接口）。
# 如果你使用 OpenAI 或其他兼容服务，只需修改 OPENAI_API_BASE 即可。
#
# 两个阶段使用不同的 client 配置：
#   - Conversation Agent：对话理解，使用主 API
#   - JSON Sub-Agent（Execution）：利用 DeepSeek FIM Completion 续写 JSON，
#     需要一个支持 prefix 续写的端点（DeepSeek 需用 /beta 端点）

# OpenAI / DeepSeek API key
OPENAI_API_KEY=<your-api-key>

# 如用 DeepSeek，按如下配置：
OPENAI_API_BASE=https://api.deepseek.com

# 必填：对话 agent 的默认模型
DEFAULT_MODEL_NAME=deepseek-v4-flash

# 可选 - 推理控制
# ENABLE_THINKING=false
# DEFAULT_REASONING_EFFORT=medium

# 可选 - Execution 阶段的独立端点/模型
#
# WORKFLOW_JSON_BASE_URL：
#   未设置时默认复用 OPENAI_API_BASE。
#   当 OPENAI_API_BASE=https://api.deepseek.com 时，自动升级为
#   https://api.deepseek.com/beta，以启用 DeepSeek FIM (Fill-in-the-Middle)
#   Completion 的 prefix 续写能力。
#   如果你显式指定了其他 provider，需确认其支持 prefix 参数。
#
# WORKFLOW_JSON_MODEL_NAME：
#   未设置时默认复用 DEFAULT_MODEL_NAME。
#
# WORKFLOW_JSON_BASE_URL=
# WORKFLOW_JSON_MODEL_NAME=

# =============================================================================
# GIF Export Runtime
# =============================================================================

# Optional Playwright / Chromium overrides for GIF export
# Keep these empty when Chromium is managed by Playwright itself.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# GIF_EXPORT_BROWSER_LAUNCH_TIMEOUT_MS=30000
# GIF_EXPORT_USE_SANDBOX=false

# =============================================================================
# PostgreSQL Configuration
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_slide
DB_USER=workflow
DB_PASSWORD=change-me

# Alternative: use DATABASE_URL instead of individual fields
# DATABASE_URL=postgresql://workflow:change-me@localhost:5432/workflow_slide

# =============================================================================
# SQLite Configuration
# =============================================================================

# SQLite file path used when STORAGE_DRIVER=sqlite
# SQLITE_FILE=./app/data/workflow-tool.sqlite

# =============================================================================
# Docker Compose Configuration
# =============================================================================
#
# These are only used by the root `docker-compose.yml`.
# Local `npm run ...` commands can ignore them.

# Docker compose modes:
# - default via COMPOSE_PROFILES=sqlite => frontend + server + SQLite
# - profile pg => frontend + server + PostgreSQL (containerized)
# - profile remote-db => frontend + server, connects to external PostgreSQL via DATABASE_URL
# - profile front-only => frontend only
# Run with:
# - `docker compose up --build -d`
# - `COMPOSE_PROFILES=pg docker compose up --build -d`
# - `COMPOSE_PROFILES=remote-db docker compose up --build -d`
# - `COMPOSE_PROFILES=front-only docker compose up --build -d`
#
# For remote-db profile, set DATABASE_URL to your external PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
# Or use individual fields:
#   DB_HOST=your-pg-host
#   DB_PORT=5432
#   DB_NAME=workflow_slide
#   DB_USER=workflow
#   DB_PASSWORD=change-me

# Default compose mode
COMPOSE_PROFILES=sqlite

# Public frontend port
FRONTEND_PORT=8080

# Public API port (used by sqlite / pg modes)
SERVER_PORT=3103

# PostgreSQL bootstrap for docker compose
POSTGRES_DB=workflow_slide
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
