FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY app/package.json app/package-lock.json ./
RUN npm ci

COPY app/ ./

ARG VITE_STORAGE_MODE=local-only
ARG VITE_API_BASE_URL=

ENV VITE_STORAGE_MODE=${VITE_STORAGE_MODE}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM nginx:1.29-alpine

ARG NGINX_TEMPLATE=frontend.local-only

COPY app/nginx /etc/workflow-nginx
RUN cp /etc/workflow-nginx/${NGINX_TEMPLATE}.conf /etc/nginx/conf.d/default.conf \
  && rm -rf /etc/workflow-nginx

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
