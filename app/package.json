{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local-db.mjs",
    "dev:local-only": "VITE_STORAGE_MODE=local-only vite",
    "dev:remote": "VITE_STORAGE_MODE=remote vite",
    "dev:local-db": "node scripts/dev-local-db.mjs",
    "server": "node --env-file=../.env server/index.mjs",
    "server:dev": "node --watch --env-file=../.env server/index.mjs",
    "db:migrate": "node --env-file=../.env server/migrate.mjs",
    "db:migrate:sqlite": "node --env-file=../.env server/migrate-sqlite.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^12.9.0",
    "gifenc": "^1.0.3",
    "openai": "^6.35.0",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
