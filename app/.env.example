# =============================================================================
# Workflow Tool - Environment Configuration
# =============================================================================
#
# Three startup modes are available:
#
# 1. local-only (default)
#    - Frontend only, no database
#    - Edit and export diagrams
#    - Browser local draft recovery
#    - Start: npm run dev:local-only (or npm run dev)
#
# 2. remote
#    - Frontend only, connects to remote API server
#    - Full database features (diagram list, revision history, save/restore)
#    - Start: npm run dev:remote
#    - Requires: VITE_API_BASE_URL pointing to remote server
#
# 3. local-db
#    - Frontend + local SQLite server
#    - Full database features with local SQLite storage
#    - Start: npm run dev:local-db
#    - Requires: STORAGE_DRIVER=sqlite (set in .env)
#
# =============================================================================
# Frontend Configuration (pick one mode)
# =============================================================================

# local-only (default - no database, browser local draft only)
VITE_STORAGE_MODE=local-only

# remote (connect to remote API server)
# VITE_STORAGE_MODE=remote
# VITE_API_BASE_URL=https://example.com/api

# local-db (local SQLite server, auto-configured by dev:local-db script)
# VITE_STORAGE_MODE=local-db
# VITE_API_BASE_URL=/api

# =============================================================================
# Server Configuration
# =============================================================================

# Storage driver: "postgres" (default) or "sqlite"
STORAGE_DRIVER=postgres

# Server port
# PORT=3103

# Schema version
# SCHEMA_VERSION=1.0

# Default dev user
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
# DEFAULT_USER_EMAIL=local-dev@workflow-tool.local
# DEFAULT_USER_NAME=Local Dev User

# =============================================================================
# PostgreSQL Configuration (required when STORAGE_DRIVER=postgres)
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_slide
DB_USER=workflow
DB_PASSWORD=change-me

# Alternative: use DATABASE_URL instead of individual fields
# DATABASE_URL=postgresql://workflow:change-me@localhost:5432/workflow_slide

# =============================================================================
# SQLite Configuration (used when STORAGE_DRIVER=sqlite)
# =============================================================================

# SQLite file path (relative to app/ directory)
# SQLITE_FILE=./data/workflow-tool.sqlite
